{
  "expo": {
    "name": "Assos Stok",
    "slug": "assos-stok",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "scheme": "assosstok",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#2b2b2b"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.assosmetal.stok",
      "buildNumber": "8",
      "requireFullScreen": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "package": "com.assosmetal.stok",
      "adaptiveIcon": {
        "backgroundColor": "#2b2b2b",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-image",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "Ürün fotoğrafı seçmek için galeri erişimi gerekir.",
          "cameraPermission": "Ürün fotoğrafı çekmek için kamera erişimi gerekir."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e80d8ec6-1130-4394-8296-94749a97380b"
      }
    },
    "owner": "4se"
  }
}
