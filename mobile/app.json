{
  "expo": {
    "name": "Assos Stok",
    "slug": "assos-stok",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "scheme": "assosstok",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#2b2b2b"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.assosmetal.stok",
      "requireFullScreen": false
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "package": "com.assosmetal.stok",
      "adaptiveIcon": {
        "backgroundColor": "#2b2b2b",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-image",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "Ürün fotoğrafı seçmek için galeri erişimi gerekir.",
          "cameraPermission": "Ürün fotoğrafı çekmek için kamera erişimi gerekir."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
